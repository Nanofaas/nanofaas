{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nanofaas:one-shot:forecast:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "provider": {
      "enum": [
        "oracle",
        "ewma"
      ]
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "const": "requests/s"
          }
        },
        "required": [
          "function",
          "generation",
          "start",
          "end",
          "rate",
          "unit"
        ]
      },
      "minItems": 0,
      "maxItems": 100000
    }
  },
  "required": [
    "schemaVersion",
    "nodeId",
    "revision",
    "provider",
    "producedAt",
    "entries"
  ]
}
