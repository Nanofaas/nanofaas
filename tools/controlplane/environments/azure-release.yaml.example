# Pin this exact Ubuntu image version. Do not replace it with `latest`.
# Resolve any future replacement once with `az vm image list --all`, review it,
# and commit the new exact URN before a comparable release run.
provider: azure
roles:
  stack:
    name: nanofaas-azure-release
    disk: 128G
  loadgen:
    name: nanofaas-azure-release-loadgen
    disk: 30G
azure:
  resource_group: nanofaas-rg
  location: westeurope
  vm_size: Standard_D4s_v5
  loadgen_vm_size: Standard_D2s_v5
  image_urn: Canonical:ubuntu-24_04-lts:server:24.04.202505280
  ssh_key_path: /home/you/.ssh/id_ed25519
