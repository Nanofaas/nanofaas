# Combined image: Rust watchdog + Java warm-echo service
#
# Usage:
#   docker build -f Dockerfile.combined -t nanofaas/java-warm-echo:watchdog ..

# Stage 1: Build Rust watchdog
FROM rust:1.97-alpine AS watchdog-builder

RUN apk add --no-cache musl-dev

WORKDIR /build
COPY runtimes/watchdog/Cargo.toml runtimes/watchdog/Cargo.lock* ./
COPY runtimes/watchdog/src ./src

RUN cargo build --release

# Stage 2: Build Java warm-echo service
FROM eclipse-temurin:25-jdk-alpine AS java-builder

WORKDIR /build
COPY gradlew settings.gradle build.gradle gradle.properties ./
COPY gradle ./gradle
COPY platform/common ./platform/common
COPY platform/control-plane ./platform/control-plane
COPY sdks/java ./sdks/java
COPY sdks/java-lite ./sdks/java-lite
COPY clients/cli ./clients/cli
COPY services/java/warm-echo ./services/java/warm-echo
COPY functions ./functions

RUN ./gradlew :services:java:warm-echo:bootJar --no-daemon

# Stage 3: jlink a minimal runtime + fetch tini, both glibc (matching the final distroless base) —
# NOT the alpine/musl java-builder above, whose binaries wouldn't be ABI-compatible here.
FROM eclipse-temurin:25-jdk AS jre-builder

WORKDIR /tmp/build
COPY --from=java-builder /build/services/java/warm-echo/build/libs/app.jar app.jar
RUN jar xf app.jar BOOT-INF/lib BOOT-INF/classes && \
    jdeps --ignore-missing-deps --multi-release 25 --recursive \
      --print-module-deps --class-path 'BOOT-INF/lib/*' \
      BOOT-INF/classes app.jar > modules.txt && \
    jlink --add-modules "$(cat modules.txt),jdk.unsupported,jdk.crypto.ec" \
      --strip-debug --no-header-files --no-man-pages --compress=zip-9 \
      --output /jre
RUN apt-get update && apt-get install -y --no-install-recommends tini && rm -rf /var/lib/apt/lists/*

# Stage 4: Final minimal image
FROM gcr.io/distroless/base-debian13:nonroot

# The :nonroot tag already runs as UID 65532; make it explicit so the intent survives tooling
USER 65532

WORKDIR /app

# Copy watchdog binary
COPY --from=watchdog-builder /build/target/release/nanofaas-watchdog /usr/local/bin/watchdog

# Copy the jlinked JRE and tini (distroless has no package manager to install either)
COPY --from=jre-builder --chown=nonroot:nonroot /jre /opt/jre
COPY --from=jre-builder /usr/bin/tini /sbin/tini

# Copy Java warm-echo service
COPY --from=jre-builder /tmp/build/app.jar /app/app.jar

# Environment defaults
ENV WARM=true
ENV EXECUTION_MODE=HTTP
ENV RUNTIME_URL=http://127.0.0.1:8081/invoke
ENV WATCHDOG_CMD="/opt/jre/bin/java -jar /app/app.jar"
ENV TIMEOUT_MS=30000

EXPOSE 8080

# Use tini as init system, watchdog as main process
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/watchdog"]
