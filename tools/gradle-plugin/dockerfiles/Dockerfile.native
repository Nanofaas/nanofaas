# Packages a native executable that assembleRecipe already compiled with GraalVM and staged as
# build/recipes/<recipe>/<component>/application (the build context), plus config/recipe.yaml
# for the control plane. Base images and runtime layout follow tools/native-java/Dockerfile.
ARG BUILDER_IMAGE=oraclelinux:9-slim
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

# Distroless has no shell: prepare the writable registry directory in the builder base.
FROM ${BUILDER_IMAGE} AS builder
RUN mkdir -p /var/lib/nanofaas && touch /var/lib/nanofaas/.keep

FROM ${RUNTIME_IMAGE}
ARG BUILDER_IMAGE
ARG RUNTIME_IMAGE
ENV NANOFAAS_BUILD_BASE_IMAGE=${BUILDER_IMAGE}
ENV NANOFAAS_RUNTIME_BASE_IMAGE=${RUNTIME_IMAGE}
ENV NANOFAAS_REGISTRY_PATH=/var/lib/nanofaas/functions.json
ENV SPRING_CONFIG_ADDITIONALLOCATION=optional:file:/app/config/recipe.yaml
WORKDIR /app
COPY --from=builder --chown=nonroot:nonroot /var/lib/nanofaas /var/lib/nanofaas
COPY . /app/
EXPOSE 8080 8081
ENTRYPOINT ["/app/application"]
