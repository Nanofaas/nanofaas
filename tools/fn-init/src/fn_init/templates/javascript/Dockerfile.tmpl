FROM docker.io/library/node:20-alpine AS build
WORKDIR /src

{{DOCKER_SDK_COPY}}
{{DOCKER_APP_COPY}}

{{DOCKER_SDK_BUILD_BLOCK}}
WORKDIR {{DOCKER_APP_DIR}}
RUN npm install
RUN npm run build
RUN npm prune --omit=dev

# Only the node binary: npm, yarn and corepack stay in the build stage.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache libstdc++ && \
    addgroup -g 1000 node && adduser -u 1000 -G node -s /bin/sh -D node
COPY --from=build /usr/local/bin/node /usr/local/bin/node
WORKDIR /app

{{DOCKER_FINAL_SDK_COPY}}
COPY --from=build {{DOCKER_APP_DIR}}/package.json ./package.json
COPY --from=build {{DOCKER_APP_DIR}}/node_modules ./node_modules
COPY --from=build {{DOCKER_APP_DIR}}/dist ./dist

EXPOSE 8080
USER node
CMD ["node", "dist/src/index.js"]
