#!/usr/bin/env bash
#
# nanoFaaS {{FUNCTION_NAME}} handler
#
# Reads InvocationRequest JSON from stdin and writes handler output JSON to stdout.
#

set -euo pipefail

req="$(cat)"

jq '
  .input as $in
  | if ($in | type) != "object" then
      {"__nanofaas_envelope__":true,"output":{"error": "Input must be a JSON object"},"statusCode":422}
    elif ($in | length) == 0 then
      {"__nanofaas_envelope__":true,"output":{"error": "Field '"'"'text'"'"' is required and must be non-empty"},"statusCode":422}
    else
      # TODO: implement handler logic
      {"result": "ok"}
    end
' <<<"$req"
