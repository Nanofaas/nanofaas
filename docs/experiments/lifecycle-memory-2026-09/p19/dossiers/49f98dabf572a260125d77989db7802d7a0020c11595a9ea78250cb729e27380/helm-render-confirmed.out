# Source: nanofaas/templates/rbac.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: nanofaas-control-plane
  namespace: "nanofaas"
subjects:
  - kind: ServiceAccount
    name: "nanofaas-control-plane"
    namespace: "nanofaas"
roleRef:
  kind: Role
  name: nanofaas-control-plane
  apiGroup: rbac.authorization.k8s.io
