{
  "cases": [
    {"name": "encodes a URL as PNG", "input": {"text": "https://example.org/invite/abc", "size": 256}, "expectedStatusCode": 200},
    {"name": "defaults the size", "input": {"text": "https://example.org/default"}, "expectedStatusCode": 200},
    {"name": "rejects missing text", "input": {}, "expected": {"error": "missing required field: text"}, "expectedStatusCode": 422},
    {"name": "rejects empty text", "input": {"text": ""}, "expected": {"error": "field 'text' must be a non-empty string"}, "expectedStatusCode": 422},
    {"name": "rejects non-string text", "input": {"text": 42}, "expected": {"error": "field 'text' must be a non-empty string"}, "expectedStatusCode": 422},
    {"name": "rejects overlong text", "input": {"text": ""}, "expected": {"error": "field 'text' must be at most 1024 UTF-8 bytes"}, "expectedStatusCode": 422},
    {"name": "rejects invalid size", "input": {"text": "https://example.org", "size": 127}, "expected": {"error": "field 'size' must be an integer between 128 and 1024"}, "expectedStatusCode": 422}
  ]
}
