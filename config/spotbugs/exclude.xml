<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- /opt/cni/bin is the documented, overridable default; configured paths must be absolute. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.containerddeploymentprovider.ContainerdProperties"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>

    <!-- Mutations share the instance monitor; volatile supports lock-free readers. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.capacity.GenerationLifecycle"/>
        <Bug pattern="VO_VOLATILE_INCREMENT"/>
    </Match>

    <!-- These maps are deliberately used as external monitors for compound lifecycle operations. -->
    <Match>
        <Or>
            <Class name="it.unimib.datai.nanofaas.modules.asyncqueue.QueueManager"/>
            <Class name="it.unimib.datai.nanofaas.modules.syncqueue.sync.SyncQueueService"/>
            <Class name="it.unimib.datai.nanofaas.controlplane.config.DispatchConnectionPool"/>
        </Or>
        <Bug pattern="JLM_JSR166_UTILCONCURRENT_MONITORENTER"/>
    </Match>

    <!-- Nullable Boolean is the documented third state: build metadata unavailable. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.buildmetadata.BuildMetadataProvider"/>
        <Method name="parseDirty"/>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>
    <!-- These are injected live collaborators, not owned value objects. Copying them
         would detach resource observations, runtime settings and peer membership. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.p2pdiscovery.NodeInformationCollector"/>
        <Method name="&lt;init&gt;"/>
        <Field name="meters"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.p2pdiscovery.NodeInformationExchange"/>
        <Method name="&lt;init&gt;"/>
        <Or><Field name="settings"/><Field name="table"/></Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The resource manager is the module's injected Spring singleton, not an owned value:
         copying it would detach the namespace and client it resolves. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.k8s.deployment.KubernetesManagedDeploymentProvider"/>
        <Field name="resourceManager"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The function registry is the application's injected Spring singleton, not an owned value:
         copying it would detach the service from the catalog every other bean reads. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.registry.FunctionService"/>
        <Field name="registry"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The coordinator, the catalog and the capacity registry are shared beans, injected once the
         test-only fallbacks are gone: a copy would detach the holder from the authority every other
         bean reads (the capacity registry is the one authority for generations). -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.registry.FunctionService"/>
        <Field name="managedDeploymentCoordinator"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.registry.ManagedDeploymentCoordinator"/>
        <Or>
            <Field name="registry"/>
            <Field name="generations"/>
        </Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ExecutionStore stays non-final so tests can wrap it in doubles; the only calls that can throw
         from its constructor are the Micrometer gauge registrations on the injected registry. The
         finding predates the single constructor, which only changed its hash. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.execution.ExecutionStore"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- The execution store, key store and metrics are the application's injected singletons, not
         owned values: copying them would split the shared admission, dedup and meter state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.service.InvocationExecutionFactory"/>
        <Or><Field name="executionStore"/><Field name="idempotencyStore"/><Field name="metrics"/></Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- The execution record is the per-execution monitor every path shares by design: publishing
         the key claim must serialize with the lifecycle's key protection on that same object. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.service.InvocationExecutionFactory$ExecutionLookup$Fresh"/>
        <Method name="publishAdmission"/>
        <Bug pattern="USO_UNSAFE_ACCESSIBLE_OBJECT_SYNCHRONIZATION"/>
    </Match>

    <!-- The injected metrics reader is shared with the decision calculator to observe live workload state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.autoscaler.InternalScaler"/>
        <Field name="metricsReader"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.api.InvocationController"/>
        <Field name="capacity"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.p2pdiscovery.DefaultPeerTransport"/>
        <Field name="table"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.forecasting.ForecastController"/>
        <Field name="store"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.forecasting.ForecastObservationLifecycle"/>
        <Field name="replicas"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.actuation.ReplicaPlanActuator"/>
        <Field name="control"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.api.OneShotController"/>
        <Or><Field name="operations"/><Field name="profiles"/></Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.api.OneShotOperations"/>
        <Or><Field name="configs"/><Field name="meters"/><Field name="profiles"/></Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Injected live collaborators; copying would detach catalog, observations or shared state. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.api.ProfileEpochInputFactory"/>
        <Or><Field name="configs"/><Field name="control"/><Field name="profiles"/></Or>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Constructor takes defensive immutable copies, including insertion-ordered snapshot maps. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.forecasting.OracleForecastStore$Trace"/>
        <Field name="entries"/>
        <Method name="entries"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- Constructor takes defensive immutable copies, including insertion-ordered snapshot maps. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.solver.LocalProblem"/>
        <Field name="functions"/>
        <Method name="functions"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- Constructor takes defensive immutable copies, including insertion-ordered snapshot maps. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.auction.AuctionSnapshot"/>
        <Or><Field name="assignments"/><Field name="desiredReplicas"/><Field name="identities"/><Field name="offers"/><Field name="peerIncarnations"/><Field name="prices"/></Or>
        <Or><Method name="assignments"/><Method name="desiredReplicas"/><Method name="identities"/><Method name="offers"/><Method name="peerIncarnations"/><Method name="prices"/></Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- These fields use the same instance monitor as all existing execution state transitions. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.execution.ExecutionRecord"/>
        <Or><Method name="pinPlannedRoute"/><Method name="plannedRoute"/><Method name="attributeExecutionNode"/><Method name="executionNode"/></Or>
        <Bug pattern="USO_UNSAFE_METHOD_SYNCHRONIZATION"/>
    </Match>
    <!-- Error transitions must share the instance monitor with other transitions and
         AttemptCoordinator's compound operations synchronized on the execution record. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.execution.ExecutionRecord"/>
        <Or>
            <Method name="markError" params="it.unimib.datai.nanofaas.common.model.ErrorInfo,java.util.Map"/>
            <Method name="markError" params="it.unimib.datai.nanofaas.common.model.ErrorInfo,java.lang.Integer,java.util.Map"/>
            <Method name="markFailure" params="it.unimib.datai.nanofaas.common.model.ErrorInfo,java.lang.Throwable,java.lang.Integer,java.util.Map"/>
        </Or>
        <Bug pattern="USO_UNSAFE_METHOD_SYNCHRONIZATION"/>
    </Match>
    <!-- The terminal failure is the caller's own exception, kept to be rethrown as the
         offload answer; copying a Throwable would lose its identity and stack. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.execution.ExecutionRecord"/>
        <Method name="markFailure"/>
        <Field name="terminalFailure"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Pausing again after a lost race is for its side effect on the provider; the
         returned token is not needed because the physical leases are retained. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.registry.ManagedDeploymentCoordinator"/>
        <Method name="~lambda\$resumeRetainedReplicas\$.*"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
    <!-- All increments hold the instance monitor; volatile permits fenced callback reads. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.actuation.ReplicaPlanActuator"/>
        <Field name="lifecycle"/>
        <Or><Method name="start"/><Method name="stop"/></Or>
        <Bug pattern="VO_VOLATILE_INCREMENT"/>
    </Match>
    <!-- All increments hold the instance monitor; volatile permits fenced callback reads. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.coordination.EpochCoordinator"/>
        <Field name="lifecycle"/>
        <Or><Method name="start"/><Method name="stop"/></Or>
        <Bug pattern="VO_VOLATILE_INCREMENT"/>
    </Match>
    <!-- RAM divided by per-replica RAM intentionally floors physical integer capacity before curve bounds. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.modules.offload.oneshot.solver.LocalReplicaSolver"/>
        <Method name="solve"/>
        <Bug pattern="ICAST_IDIV_CAST_TO_DOUBLE"/>
    </Match>
    <!-- Live runtime/registry collaborators must remain shared, not copied as value objects. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.containerdeployment.LocalManagedDeploymentProvider"/>
        <Method name="&lt;init&gt;"/>
        <Field name="adapter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="it.unimib.datai.nanofaas.controlplane.dispatch.DispatcherRouter"/>
        <Method name="&lt;init&gt;"/>
        <Field name="deployments"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Reservations must share the pool's monitor with admission, membership updates and close. -->
    <Match>
        <Class name="it.unimib.datai.nanofaas.containerdeployment.ManagedReplicaPool$Reservation"/>
        <Or><Method name="markDispatched"/><Method name="close"/></Or>
        <Bug pattern="USO_UNSAFE_OBJECT_SYNCHRONIZATION"/>
    </Match>
</FindBugsFilter>
