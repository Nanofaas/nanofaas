[importlinter]
root_packages =
    controlplane_tool
    workflow_tasks

[importlinter:contract:core_is_independent]
name = core must not import product packages
type = forbidden
source_modules = controlplane_tool.core
forbidden_modules =
    controlplane_tool.app
    controlplane_tool.cli
    controlplane_tool.config
    controlplane_tool.functions
    controlplane_tool.plans
    controlplane_tool.tui
    controlplane_tool.workspace

[importlinter:contract:no_runtime_dependency_on_tui]
name = runtime packages must not depend on tui
type = forbidden
source_modules =
    controlplane_tool.cli
    controlplane_tool.config
    controlplane_tool.core
    controlplane_tool.functions
    controlplane_tool.plans
    controlplane_tool.workspace
forbidden_modules = controlplane_tool.tui

[importlinter:contract:workflow_tasks_is_independent]
name = workflow_tasks must not depend on controlplane
type = forbidden
source_modules = workflow_tasks
forbidden_modules = controlplane_tool
include_external_packages = True
