# Pin this exact Ubuntu image version. Do not replace it with `latest`.
# Resolve replacements with the deployment GET endpoint — the list endpoint
# advertises versions that 404 on deploy:
#   az vm image show --urn Canonical:ubuntu-24_04-lts:server:latest --location westeurope
# then pin the version it reports and commit it before a comparable release run.
provider: azure
roles:
  stack:
    name: nanofaas-azure-release
    disk: 128G
    # Azure VMs log in as azureuser; without this, remote paths default to
    # /home/ubuntu and loadgen preparation fails.
    user: azureuser
  loadgen:
    name: nanofaas-azure-release-loadgen
    disk: 30G
    user: azureuser
azure:
  resource_group: nanofaas-rg
  location: westeurope
  vm_size: Standard_D8s_v5
  loadgen_vm_size: Standard_D2s_v5
  image_urn: Canonical:ubuntu-24_04-lts:server:24.04.202607140
  # Replace with the bounded operator/VPN CIDR allowed to query API/Prometheus.
  operator_source_cidr: 203.0.113.0/24
  # PUBLIC key path (the matching private key must sit next to it, without .pub).
  ssh_key_path: /home/you/.ssh/id_rsa.pub
