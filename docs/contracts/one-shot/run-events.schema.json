{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nanofaas:one-shot:run-events:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "incarnation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "monotonicOffsetNanos": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "censored": {
      "type": "boolean"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schemaVersion",
    "nodeId",
    "incarnation",
    "epoch",
    "round",
    "type",
    "monotonicOffsetNanos",
    "at",
    "status",
    "censored",
    "correlationId"
  ]
}
