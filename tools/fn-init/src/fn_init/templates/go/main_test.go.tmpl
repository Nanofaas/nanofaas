package main

import (
	"context"
	"testing"

	"github.com/miciav/nanofaas/function-sdk-go/nanofaas"
)

func TestHandle{{CLASS_NAME}}ReturnsResult(t *testing.T) {
	result, err := handle{{CLASS_NAME}}(context.Background(), nanofaas.InvocationRequest{Input: map[string]any{"text": "hello"}})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if result == nil {
		t.Fatal("expected non-nil result")
	}
}

func TestHandle{{CLASS_NAME}}RejectsEmptyInput(t *testing.T) {
	result, err := handle{{CLASS_NAME}}(context.Background(), nanofaas.InvocationRequest{Input: map[string]any{}})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	response, ok := result.(nanofaas.HandlerResponse)
	if !ok {
		t.Fatal("expected HandlerResponse result")
	}
	if response.StatusCode != 422 {
		t.Fatalf("expected status 422, got %d", response.StatusCode)
	}
}
