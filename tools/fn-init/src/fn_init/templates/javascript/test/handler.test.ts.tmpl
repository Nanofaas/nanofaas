import { describe, test, expect, vi } from "vitest";
import { handle{{CLASS_NAME}} } from "../src/handler";
import type { Context, InvocationRequest } from "nanofaas-function-sdk";

function ctx(): Context {
    return {
        requestId: "test",
        executionId: "test-exec",
        logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },
    } as unknown as Context;
}

describe("{{FUNCTION_NAME}} handler", () => {
    test("returns result for valid input", async () => {
        const result = await handle{{CLASS_NAME}}(ctx(), { input: { text: "hello" } });
        expect(result).toBeDefined();
    });

    test("returns error for empty input", async () => {
        const result = await handle{{CLASS_NAME}}(ctx(), { input: {} });
        expect(result).toHaveProperty("error");
    });
});
