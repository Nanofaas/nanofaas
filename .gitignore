# Compiled benchmark harnesses under docs/experiments/*/. Their .class files are already covered by
# the global rule; the directory also receives generated run configuration.
docs/experiments/*/.classes/
docs/experiments/*/.classes-old/
# Classpath caches the benchmark run.sh scripts ask of Gradle once: absolute paths of one machine,
# regenerated by the scripts whenever missing or stale.
docs/experiments/*/.classpath-*
tooling/runs/
tools/controlplane/runs/
tools/controlplane/profiles/proxmox.toml
tools/controlplane/profiles/azure.toml
recovery/
.gitnexus
.superpowers/

# coverage artifacts
.coverage

# SonarQube scanner work directory
.scannerwork/

# stray test artifact (mistaken MagicMock filesystem writes)
MagicMock/
tools/controlplane/environments/azure*.yaml

