import assert from "node:assert/strict";
import { test } from "node:test";

import { getLogger, HandlerResponse, type HandlerContext } from "nanofaas-function-sdk";

import { handle{{CLASS_NAME}} } from "../src/handler.js";

function createContext(): HandlerContext {
    return {
        executionId: "exec-test",
        logger: getLogger("{{FUNCTION_NAME}}.test"),
        signal: new AbortController().signal,
        isColdStart: false,
    };
}

test("{{FUNCTION_NAME}} handler returns result for valid input", async () => {
    const result = await handle{{CLASS_NAME}}(createContext(), {
        input: { text: "hello" },
    });
    assert.ok(result, "handler must return a result");
});

test("{{FUNCTION_NAME}} handler returns error for empty input", async () => {
    const result = await handle{{CLASS_NAME}}(createContext(), {
        input: {},
    });
    assert.ok(result instanceof HandlerResponse);
    assert.equal(result.statusCode, 422);
});
